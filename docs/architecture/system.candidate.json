  "cards": [
    {
      "dot": "cyan",
      "title": "Two backend patterns",
      "items": [
        "tabpfn-hosted: plain HTTPS, no local stack \u2014 classification, regression, forecast, anomaly",
        "nvidia-sdm: KumoTabular in-context inside a CUDA venv; the core never imports torch"
      ]
    },
    {
      "dot": "emerald",
      "title": "One contract",
      "items": [
        "TableResult is the public wire shape \u2014 19 frozen top-level keys, additive-only growth",
        "task_type enum grew additively: classification \u00b7 regression \u00b7 forecast \u00b7 anomaly"
      ]
    },
    {
      "dot": "rose",
      "title": "Hard rules",
      "items": [
        "Dataset cells ride only in signed-upload bodies; telemetry keeps shapes and hashes",
        "Fail-open: backend failures return verdict=error, never raise out",
        "Confidence floors are per backend \u2014 hosted, in-context, and coverage never share a number"
      ]
    }
  ]
